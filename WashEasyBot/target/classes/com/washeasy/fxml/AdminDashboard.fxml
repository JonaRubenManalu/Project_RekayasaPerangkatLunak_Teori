<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox fx:id="rootPane" styleClass="root-pane"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.washeasy.controller.AdminDashboardController">

    <!-- ══ NAVBAR ══ -->
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="navbar">
        <padding><Insets bottom="0" left="20" right="20" top="0" /></padding>
        <Label prefHeight="32.0" prefWidth="59.0" style="-fx-font-size:22px;" />
        <ImageView fitHeight="63.0" fitWidth="108.0" preserveRatio="true">
            <image><Image url="@../images/logo.png" /></image>
        </ImageView>
        <VBox spacing="0">
            <Label styleClass="nav-brand" text="WashEasy" />
            <Label styleClass="nav-sub"   text="ADMIN PANEL" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblUsername" styleClass="nav-user" text="Admin" />
        <Button onAction="#handleLogout" styleClass="btn-logout" text="Logout" />
    </HBox>

    <!-- ══ HERO BANNER ══ -->
    <HBox alignment="CENTER_LEFT" styleClass="hero-banner">
        <padding><Insets bottom="14" left="24" right="24" top="14" /></padding>
        <VBox spacing="2">
            <Text fx:id="txtWelcome" styleClass="hero-title"
                  text="Selamat Datang Admin di WashEasy 👋"
                  wrappingWidth="500" />
            <Label styleClass="hero-sub-text"
                   text="Kelola layanan dan pesanan laundry dengan mudah" />
        </VBox>
    </HBox>

    <!-- ══ STAT CARDS ══ -->
    <HBox spacing="12" style="-fx-padding:12 24 8 24;">
        <VBox maxWidth="Infinity" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="Total Layanan" />
            <Label fx:id="lblTotalLayanan" styleClass="stat-value" text="0" />
        </VBox>
        <VBox maxWidth="Infinity" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-label" text="Layanan Aktif" />
            <Label fx:id="lblLayananAktif" styleClass="stat-value" text="0" />
        </VBox>
    </HBox>

    <!-- ══ TAB PANE ══ -->
    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE"
             style="-fx-background-color:transparent;-fx-padding:0 24 16 24;">

        <!-- ════ TAB 1: MANAJEMEN LAYANAN ════ -->
        <Tab text="🛠 Manajemen Layanan">
            <HBox spacing="16" style="-fx-padding:12 0 0 0;">

                <!-- Tabel layanan — mengisi sisa ruang horizontal -->
                <VBox spacing="8" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label styleClass="section-title" text="Data Layanan Laundry" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleTambah" styleClass="btn-primary" text="+ Tambah" />
                        <Button onAction="#handleHapus"  styleClass="btn-danger"  text="Hapus" />
                    </HBox>

                    <TableView fx:id="tblLayanan" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId"        prefWidth="50"  text="ID" />
                            <TableColumn fx:id="colNama"      prefWidth="180" text="Nama Layanan" />
                            <TableColumn fx:id="colDeskripsi" prefWidth="220" text="Deskripsi" />
                            <TableColumn fx:id="colHarga"     prefWidth="110" text="Harga" />
                            <TableColumn fx:id="colSatuan"    prefWidth="80"  text="Satuan" />
                            <TableColumn fx:id="colEstimasi"  prefWidth="100" text="Estimasi" />
                        </columns>
                        <placeholder>
                            <Label styleClass="text-muted" text="Belum ada data layanan." />
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Form tambah/edit — lebar tetap -->
                <VBox prefWidth="280" minWidth="240" spacing="10" styleClass="form-card">
                    <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
                    <Label styleClass="form-card-title" text="Form Layanan" />

                    <Label styleClass="input-label" text="Nama Layanan *" />
                    <TextField fx:id="fldNama" promptText="cth: Laundry Reguler"
                               styleClass="form-input" />

                    <Label styleClass="input-label" text="Deskripsi" />
                    <TextField fx:id="fldDeskripsi" promptText="Deskripsi singkat"
                               styleClass="form-input" />

                    <Label styleClass="input-label" text="Harga (Rp) *" />
                    <TextField fx:id="fldHarga" promptText="cth: 7000" styleClass="form-input" />

                    <Label styleClass="input-label" text="Satuan *" />
                    <ComboBox fx:id="cmbSatuan" maxWidth="Infinity" styleClass="form-input" />

                    <Label styleClass="input-label" text="Estimasi Waktu *" />
                    <TextField fx:id="fldEstimasi" promptText="cth: 2-3 hari"
                               styleClass="form-input" />

                    <Label fx:id="lblFormStatus" styleClass="status-label" text="" wrapText="true" />

                    <Region VBox.vgrow="ALWAYS" />

                    <HBox spacing="8">
                        <Button fx:id="btnBatal" maxWidth="Infinity" onAction="#handleBatal"
                                styleClass="btn-secondary" text="Batal" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnSimpan" maxWidth="Infinity" onAction="#handleSimpan"
                                styleClass="btn-primary" text="Simpan" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

            </HBox>
        </Tab>

        <!-- ════ TAB 2: MANAJEMEN PESANAN ════ -->
        <Tab text="📦 Manajemen Pesanan">
            <VBox spacing="12" style="-fx-padding:12 0 0 0;" VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#1E293B;"
                           text="📦 Semua Pesanan Customer" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleSiapDiambil"
                            style="-fx-background-color:#10B981;-fx-text-fill:white;
                                   -fx-background-radius:6px;-fx-padding:6 16;
                                   -fx-font-weight:bold;"
                            text="✅ Tandai Siap Diambil" />
                    <Button onAction="#handleRefreshPesanan"
                            style="-fx-background-color:#2563EB;-fx-text-fill:white;
                                   -fx-background-radius:6px;-fx-padding:6 14;"
                            text="🔄 Refresh" />
                </HBox>

                <TableView fx:id="tblPesanan" VBox.vgrow="ALWAYS" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="colPId"      prefWidth="50"  text="ID" />
                        <TableColumn fx:id="colPUser"    prefWidth="120" text="Customer" />
                        <TableColumn fx:id="colPLayanan" prefWidth="160" text="Layanan" />
                        <TableColumn fx:id="colPBerat"   prefWidth="90"  text="Berat/Jml" />
                        <TableColumn fx:id="colPTotal"   prefWidth="120" text="Total Harga" />
                        <TableColumn fx:id="colPStatus"  prefWidth="130" text="Status" />
                        <TableColumn fx:id="colPMetode"  prefWidth="130" text="Metode Ambil" />
                        <TableColumn fx:id="colPAlamat"  prefWidth="180" text="Alamat" />
                        <TableColumn fx:id="colPTanggal" prefWidth="160" text="Tanggal Pesan" />
                    </columns>
                    <placeholder>
                        <Label text="Belum ada pesanan masuk." />
                    </placeholder>
                </TableView>

                <Label fx:id="lblPesananStatus"
                       style="-fx-font-size:12px;-fx-text-fill:#1E293B;" text="" />

                <Label style="-fx-text-fill:#64748B;-fx-font-size:11px;"
                       text="Klik baris pesanan, lalu tekan 'Tandai Siap Diambil' untuk mengubah status." />
            </VBox>
        </Tab>

        <!-- ════ TAB 3 [NEW]: INFO KEDAI ════ -->
        <Tab text="🏪 Info Kedai">
            <VBox spacing="14" style="-fx-padding:16 0 0 0;" VBox.vgrow="ALWAYS">
                <Label style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#1E293B;"
                       text="🏪 Kelola Info Kedai (Jam Operasional &amp; Lokasi)" />
                <Label style="-fx-text-fill:#64748B;-fx-font-size:11px;"
                       text="Data ini ditampilkan secara dinamis oleh chatbot — bukan hardcode." />

                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label styleClass="input-label" text="Jam Buka *" />
                        <TextField fx:id="fldJamBuka" promptText="cth: 09:00" styleClass="form-input" />
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label styleClass="input-label" text="Jam Tutup *" />
                        <TextField fx:id="fldJamTutup" promptText="cth: 22:00" styleClass="form-input" />
                    </VBox>
                </HBox>

                <Label styleClass="input-label" text="Lokasi / Alamat Kedai *" />
                <TextArea fx:id="fldLokasi" prefRowCount="3"
                          promptText="cth: Jl. Dr. Wahidin No. 5, Kotabaru, Yogyakarta"
                          styleClass="form-input" wrapText="true" />

                <HBox spacing="8">
                    <Button onAction="#handleSimpanInfoKedai"
                            style="-fx-background-color:#2563EB;-fx-text-fill:white;
                                   -fx-background-radius:6px;-fx-padding:8 20;-fx-font-weight:bold;"
                            text="💾 Simpan Info Kedai" />
                </HBox>
                <Label fx:id="lblInfoKedaiStatus" style="-fx-font-size:12px;" text="" />
            </VBox>
        </Tab>

        <!-- ════ TAB 4 [NEW]: FASILITAS ════ -->
        <Tab text="✨ Fasilitas">
            <HBox spacing="16" style="-fx-padding:12 0 0 0;">

                <!-- Tabel fasilitas -->
                <VBox spacing="8" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#1E293B;"
                               text="✨ Daftar Fasilitas" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleHapusFasilitas"
                                style="-fx-background-color:#EF4444;-fx-text-fill:white;
                                       -fx-background-radius:6px;-fx-padding:6 14;-fx-font-weight:bold;"
                                text="Hapus" />
                    </HBox>
                    <TableView fx:id="tblFasilitas" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colFasId"   prefWidth="50"  text="ID" />
                            <TableColumn fx:id="colFasNama" prefWidth="200" text="Nama Fasilitas" />
                            <TableColumn fx:id="colFasKet"  prefWidth="320" text="Keterangan" />
                        </columns>
                        <placeholder>
                            <Label text="Belum ada data fasilitas." />
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Form fasilitas -->
                <VBox prefWidth="280" minWidth="240" spacing="10" styleClass="form-card">
                    <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
                    <Label styleClass="form-card-title" text="Form Fasilitas" />

                    <Label styleClass="input-label" text="Nama Fasilitas *" />
                    <TextField fx:id="fldFasNama" promptText="cth: Mesin Cuci Front Loading"
                               styleClass="form-input" />

                    <Label styleClass="input-label" text="Keterangan" />
                    <TextField fx:id="fldFasKet" promptText="Deskripsi fasilitas"
                               styleClass="form-input" />

                    <Label fx:id="lblFasilitasStatus" styleClass="status-label" text="" wrapText="true" />
                    <Region VBox.vgrow="ALWAYS" />

                    <HBox spacing="8">
                        <Button maxWidth="Infinity" onAction="#handleBatalFasilitas"
                                styleClass="btn-secondary" text="Batal" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" onAction="#handleSimpanFasilitas"
                                styleClass="btn-primary" text="Simpan" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

            </HBox>
        </Tab>

        <!-- ════ TAB 5 [NEW]: TEMPLATE PERTANYAAN (KEYWORDS) ════ -->
        <Tab text="💬 Template Pertanyaan">
            <HBox spacing="16" style="-fx-padding:12 0 0 0;">

                <!-- Tabel keywords -->
                <VBox spacing="8" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-font-size:15px;-fx-font-weight:bold;-fx-text-fill:#1E293B;"
                               text="💬 Keyword Chatbot" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleHapusKeyword"
                                style="-fx-background-color:#EF4444;-fx-text-fill:white;
                                       -fx-background-radius:6px;-fx-padding:6 14;-fx-font-weight:bold;"
                                text="Hapus" />
                    </HBox>
                    <Label style="-fx-text-fill:#64748B;-fx-font-size:11px;"
                           text="Keyword ini digunakan chatbot untuk mengenali pertanyaan user secara dinamis dari database." />
                    <TableView fx:id="tblKeywords" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colKwId"       prefWidth="50"  text="ID" />
                            <TableColumn fx:id="colKwKeyword"  prefWidth="200" text="Keyword" />
                            <TableColumn fx:id="colKwCategory" prefWidth="170" text="Kategori" />
                            <TableColumn fx:id="colKwPriority" prefWidth="80"  text="Prioritas" />
                        </columns>
                        <placeholder>
                            <Label text="Belum ada keyword." />
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Form keyword -->
                <VBox prefWidth="280" minWidth="240" spacing="10" styleClass="form-card">
                    <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
                    <Label styleClass="form-card-title" text="Form Keyword" />

                    <Label styleClass="input-label" text="Keyword *" />
                    <TextField fx:id="fldKwKeyword" promptText="cth: jam buka"
                               styleClass="form-input" />

                    <Label styleClass="input-label" text="Kategori *" />
                    <ComboBox fx:id="cmbKwCategory" maxWidth="Infinity" styleClass="form-input" />

                    <Label styleClass="input-label" text="Prioritas (1–10)" />
                    <TextField fx:id="fldKwPriority" promptText="1" styleClass="form-input" />

                    <Label fx:id="lblKeywordsStatus" styleClass="status-label" text="" wrapText="true" />
                    <Region VBox.vgrow="ALWAYS" />

                    <HBox spacing="8">
                        <Button maxWidth="Infinity" onAction="#handleBatalKeyword"
                                styleClass="btn-secondary" text="Batal" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" onAction="#handleSimpanKeyword"
                                styleClass="btn-primary" text="Simpan" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

            </HBox>
        </Tab>

    </TabPane>

</VBox>
